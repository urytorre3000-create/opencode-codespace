# GitHub Codespaces para OpenCode
#
# Esta plantilla deja OpenCode instalado y listo en GitHub Codespaces.
# Copia la carpeta .devcontainer al repositorio que quieras abrir en Codespaces.
{
  "name": "opencode",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu:24.04",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },

  "postCreateCommand": {
    "install-opencode": "npm install -g opencode-ai && bash ./.devcontainer/setup.sh"
  },

  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode server",
      "onAutoForward": "notify"
    }
  },

  "remoteUser": "vscode"
}
