@urytorre3000-create# Copia este archivo a .env para desarrollo local, o añade estas variables
# en GitHub: Settings -> Secrets and variables -> Codespaces (repo) -> Secrets.
#
# La clave va a un Secret GITHUB (no al repositorio), nunca al commit.

DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Token del bot de Telegram (créalo con @BotFather)
# Cómo obtenerlo: https://t.me/BotFather -> /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =========================================================================== #
# Recordatorio diario de calistenia por correo (enviar_recordatorio_diario.py)
# =========================================================================== #
# Gmail: https://myaccount.google.com/apppasswords  ->  genera una
# "contraseña de aplicación" (16 caracteres) y pégala en SMTP_PASSWORD.
# (NO uses tu contraseña normal de Gmail.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Destinatario del recordatorio (si se omite, usa SMTP_USER)
EMAIL_TO=tu_correo@gmail.com
